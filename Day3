53. Maximum Subarray

class Solution {
    public int maxSubArray(int[] num) {
        int maxSum = Integer.MIN_VALUE;
        int currentSum = 0;

        for(int i=0;i<num.length;i++){
            currentSum += num[i];

            if(currentSum > maxSum){
                maxSum = currentSum;
            }

            if(currentSum<0){
                currentSum = 0;
            }
        }
        return maxSum;
    }
}
